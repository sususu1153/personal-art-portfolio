---
import Base from '../../layouts/Base.astro';
import Board from '../../components/Board.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { artworks } from '../../data/artworks';
import { statement } from '../../data/site';
---
<Base title="Work" description="Illustrations and mixed-media work by Suzie Lou.">
  <section class="head">
    <h1><span class="hl">Work</span></h1>
    <div class="side">
      <p class="count">{artworks.length} pieces &middot; 2023&ndash;2025</p>
      <!-- shown by the script below; without JS there is only the list -->
      <div class="toggle" role="group" aria-label="View" hidden>
        <button type="button" data-view="list" aria-pressed="true">list</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-view="grid" aria-pressed="false">grid</button>
      </div>
    </div>
  </section>

  <div class="views" data-current="list">
    <div class="view-list"><WorkIndex items={artworks} /></div>
    <div class="view-grid"><Board items={artworks} layout="columns" /></div>
  </div>

  <section class="statement">
    <h2><span class="hl r">Artist</span><br /><span class="hl r">statement</span></h2>
    <div>
      {statement.map((p) => <p data-marker>{p}</p>)}
    </div>
  </section>
</Base>

<script>
  // List / grid toggle, remembered per visitor.
  const views = document.querySelector<HTMLElement>('.views')!;
  const toggle = document.querySelector<HTMLElement>('.toggle')!;
  const buttons = toggle.querySelectorAll<HTMLButtonElement>('[data-view]');
  const show = (view: string) => {
    views.dataset.current = view;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    // pieces in a freshly shown view paste in right away instead of waiting for a scroll
    views
      .querySelectorAll(`.view-${view} [data-paste], .view-${view} [data-anim]`)
      .forEach((el) => el.classList.add('in'));
  };
  toggle.hidden = false;
  try {
    if (localStorage.getItem('work-view') === 'grid') show('grid');
  } catch {}
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      show(b.dataset.view!);
      try {
        localStorage.setItem('work-view', b.dataset.view!);
      } catch {}
    }),
  );
</script>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) 2rem;
  }
  h1 { font-size: clamp(4rem, 13vw, 12rem); text-transform: uppercase; }
  .side { text-align: right; font-weight: 700; }
  .toggle { display: flex; margin-top: 0.5rem; gap: 0.4rem; justify-content: flex-end; }
  .toggle[hidden] { display: none; }
  button {
    font: inherit;
    font-weight: 700;
    color: inherit;
    background: none;
    border: 0;
    padding: 0 0.3rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  button[aria-pressed='true'] { background: var(--marigold); text-decoration: none; }

  .views[data-current='list'] .view-grid,
  .views[data-current='grid'] .view-list { display: none; }

  .statement {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding: 4rem var(--gutter);
    margin-top: 3rem;
    border-top: 2px dashed var(--ink);
  }
  h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .statement h2 span { display: inline-block; transform: rotate(-2deg); }
  .statement h2 span:nth-of-type(2) { transform: rotate(1.5deg); margin: 0.1em 0 0 0.6em; }
  .statement p { font-size: 1.1rem; max-width: 60ch; }
  .statement p + p { margin-top: 1rem; }

  @media (max-width: 700px) {
    .side { text-align: left; }
    .toggle { justify-content: flex-start; }
    .statement { grid-template-columns: 1fr; }
  }
</style>
