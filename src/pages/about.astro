---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import photo from '../assets/photo/suzie.webp';

// From Suzie's art resume.
const training = [
  ['2025 – 2026', 'AP 2-D Art and Design', 'Scored a 5 on the AP exam. Conceptual pieces ' +
    'exploring the instability of identities'],
  ['2024 – 2025', 'Advanced Painting', 'Figure studies, still lifes'],
  ['2020 – now', 'Self-taught drawing', 'Alcohol markers, colored pencils, mixed media'],
];
const shown = [
  ['2025', '“Principles” group exhibition', 'Foreman Gallery, Hartwick College'],
  ['2025', '“Sing Along”', 'Apricus Literary Magazine, Issue 03'],
  ['2021 – 2022', 'Yearbook cover artist', 'Albany Middle School'],
];
const design = [
  ['2025 – 2026', 'Graphic designer', 'Wizard’s Wardrobe, an after-school English ' +
    'tutoring program: visual brand, social posts, event highlights'],
  ['2024 – now', 'Outreach lead', 'The Hyperbolic Review, a math-poetry magazine: ' +
    'website layout, social visuals, interviews with math poets',
    'https://www.thehyperbolicreview.com/'],
  ['2022, 2025', 'Team T-shirts', 'Science Olympiad, worn by 80+ students, coaches, and ' +
    'teachers'],
  ['2022 – 2024', 'Key Club', '35+ drawings delivered to local hospitals and nursing ' +
    'homes; posters and flyers for local nonprofits'],
];
const sections = [
  { title: 'Training', color: 'hl', rows: training },
  { title: 'Shown & published', color: 'hl r', rows: shown },
  { title: 'Design work', color: 'hl b', rows: design },
];
---
<Base title="About" description="About Suzie Lou, illustrator and graphic designer.">
  <section class="intro">
    <figure class="portrait" data-paste style="--tilt: -1.5deg">
      <span class="tape y"></span>
      <Image src={photo} alt="Suzie Lou sitting by a tall window, looking up at the sky"
        widths={[500, 900, 1400]} sizes="(max-width: 700px) 90vw, 38vw" loading="eager" />
    </figure>
    <div class="about-text">
      <h1><span class="hl">Hi, I&rsquo;m</span><br /><span class="hl r">Suzie.</span></h1>
      <p class="lede" data-type="14" data-marker>
        I&rsquo;m Suzie. I draw people who are stretching, cracking, or smiling a little too
        hard, mostly in alcohol markers and colored pencils. I&rsquo;m also majoring in
        applied math at UC San Diego.
      </p>
      <p class="contact">
        <a href={`mailto:${site.email}`}><span class="hl k">{site.email}</span></a><br />
        <a href={site.github}>github.com/sususu1153</a>
      </p>
    </div>
  </section>

  {sections.map((s) => (
    <section class="list">
      <h2><span class={s.color}>{s.title}</span></h2>
      <ul>
        {s.rows.map(([when, what, detail, link]) => (
          <li>
            <span class="when">{when}</span><b>{what}</b>
            <span>
              {detail}
              {link && (
                <>
                  {' '}
                  <a class="ext" href={link} target="_blank" rel="noopener">
                    {new URL(link).hostname.replace(/^www\./, '')}&nbsp;&#8599;
                  </a>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) 4rem;
    align-items: center;
  }
  /* the whole photo, taped onto the page like the artwork */
  .portrait {
    position: relative;
    background: #fff;
    padding: 0.7rem;
    transform: rotate(-1.5deg);
  }
  .about-text { display: grid; gap: 2rem; align-content: center; }
  h1 { font-size: clamp(3.5rem, 10vw, 9rem); text-transform: uppercase; }
  h1 .hl.r { display: inline-block; transform: rotate(-2deg); }
  .lede { font-size: 1.2rem; max-width: 46ch; }
  .contact { font-weight: 700; line-height: 2; }
  .contact a { text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .list {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding: 2.5rem var(--gutter);
    border-top: 2px dashed var(--ink);
  }
  h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); }
  ul { list-style: none; padding: 0; }
  li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    column-gap: 1rem;
    padding: 0.6rem 0;
  }
  li + li { border-top: 1px solid rgb(29 27 25 / 0.2); }
  .when { grid-row: 1 / span 2; font-weight: 700; }
  .ext { font-weight: 700; text-underline-offset: 3px; }
  .ext:hover { background: var(--marigold); }

  @media (max-width: 700px) {
    .intro, .list { grid-template-columns: 1fr; }
    .portrait { width: 88%; }
    li { grid-template-columns: 1fr; }
    .when { grid-row: auto; }
  }
</style>
